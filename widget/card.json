{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "$when": "${temp != ''}",
      "columns": [
        { "type": "Column", "width": "auto", "verticalContentAlignment": "Center",
          "items": [ { "type": "TextBlock", "text": "${icon}", "size": "ExtraLarge" } ] },
        { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${temp}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" },
            { "type": "TextBlock", "text": "${summary}", "$when": "${$host.widgetSize != 'small'}", "isSubtle": true, "spacing": "None", "wrap": false },
            { "type": "TextBlock", "text": "${short}", "$when": "${$host.widgetSize == 'small'}", "isSubtle": true, "spacing": "None", "wrap": false }
          ] }
      ]
    },
    { "type": "TextBlock", "text": "${note}", "$when": "${note != ''}", "wrap": true, "isSubtle": true },
    { "type": "TextBlock", "text": "${range}", "$when": "${temp != '' && $host.widgetSize != 'small'}", "spacing": "Small", "wrap": true },
    { "type": "TextBlock", "text": "${detail}", "$when": "${detail != '' && $host.widgetSize == 'large'}", "isSubtle": true, "spacing": "None", "wrap": true },
    { "type": "TextBlock", "text": "${air}", "$when": "${air != '' && $host.widgetSize == 'large'}", "isSubtle": true, "spacing": "None", "wrap": true },
    { "type": "TextBlock", "text": "${sun}", "$when": "${sun != '' && $host.widgetSize == 'large'}", "isSubtle": true, "spacing": "None", "wrap": true },
    { "type": "TextBlock", "text": "${meeting}", "$when": "${meeting != '' && $host.widgetSize != 'small'}", "weight": "Bolder", "spacing": "Medium", "wrap": true, "maxLines": 1 },
    { "type": "TextBlock", "text": "${meetingShort}", "$when": "${meetingShort != '' && $host.widgetSize == 'small'}", "weight": "Bolder", "spacing": "Medium" },
    { "type": "TextBlock", "text": "${focus}", "$when": "${focus != ''}", "spacing": "Small", "wrap": true, "maxLines": 1 },
    { "type": "TextBlock", "text": "${tasks}", "$when": "${tasks != '' && (meeting == '' || $host.widgetSize != 'small')}", "spacing": "Small", "wrap": true },
    { "type": "TextBlock", "text": "${taskList}", "$when": "${taskList != '' && $host.widgetSize == 'medium'}", "isSubtle": true, "spacing": "None", "wrap": true, "maxLines": 2 },
    {
      "type": "Container",
      "$when": "${todoAny != '' && $host.widgetSize == 'large'}",
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${todo}",
          "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center",
              "items": [ { "type": "TextBlock", "text": "${text}", "wrap": false, "maxLines": 1 } ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "Center",
              "items": [ { "type": "ActionSet", "actions": [
                { "type": "Action.Execute", "title": "✓", "tooltip": "Mark done", "verb": "done", "data": { "key": "${key}" } } ] } ] }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${habits}", "$when": "${habits != '' && $host.widgetSize == 'large'}", "spacing": "Small", "wrap": true },
    {
      "type": "ColumnSet",
      "$when": "${$host.widgetSize != 'small'}",
      "spacing": "Medium",
      "columns": [
        { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center",
          "items": [ { "type": "Input.Text", "id": "text", "placeholder": "Add a task", "maxLength": 200 } ] },
        { "type": "Column", "width": "auto", "verticalContentAlignment": "Center",
          "items": [ { "type": "ActionSet", "actions": [ { "type": "Action.Execute", "title": "Add", "verb": "add" } ] } ] }
      ]
    },
    {
      "type": "ColumnSet",
      "$when": "${focusOn == '' && $host.widgetSize != 'small'}",
      "spacing": "Small",
      "columns": [
        { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center",
          "items": [ { "type": "Input.Number", "id": "minutes", "label": "Focus minutes", "value": 25, "min": 1, "max": 480, "placeholder": "Minutes" } ] },
        { "type": "Column", "width": "auto", "verticalContentAlignment": "Bottom",
          "items": [ { "type": "ActionSet", "actions": [ { "type": "Action.Execute", "title": "Start focus", "verb": "focus" } ] } ] }
      ]
    },
    { "type": "ActionSet", "$when": "${focusOn != '' && $host.widgetSize != 'small'}", "spacing": "Small",
      "actions": [ { "type": "Action.Execute", "title": "Stop focus", "verb": "stop" } ] },
    { "type": "TextBlock", "text": "${status}", "$when": "${status != ''}", "color": "Attention", "size": "Small", "spacing": "Small", "wrap": true },
    { "type": "TextBlock", "text": "${updated}", "$when": "${$host.widgetSize == 'large'}", "size": "Small", "isSubtle": true, "spacing": "Medium" }
  ]
}
