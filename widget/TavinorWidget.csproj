<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tavinor's Windows widget provider (lock screen and widget board).
       It only reads widget.json, which Tavinor writes; it never acts.
       Built by packaging/build_msix.py into the MSIX package. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Only ever runs inside the MSIX, which loads the Windows App Runtime through
         its PackageDependency. The unpackaged bootstrapper fails there
         (0x80070032) and kills the process before it registers with COM. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationIcon>..\tavinor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="card.json" />
    <EmbeddedResource Include="customize.json" />
    <Compile Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>
</Project>
