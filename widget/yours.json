{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${yours1}",
      "size": "${yoursSize}",
      "color": "${yoursColor}",
      "weight": "Bolder",
      "spacing": "None",
      "wrap": true,
      "maxLines": 2,
      "$when": "${yours1 != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${yours2}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 1,
      "isSubtle": true,
      "$when": "${yours2 != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${yoursNote}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 3,
      "isSubtle": true,
      "$when": "${yoursNote != ''}"
    }
  ]
}
