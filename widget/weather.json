{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "$when": "${temp != ''}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon}",
              "size": "ExtraLarge"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${temp}",
              "size": "ExtraLarge",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${short}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 1,
      "$when": "${temp != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${rangeShort}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 1,
      "isSubtle": true,
      "$when": "${temp != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${place}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 1,
      "isSubtle": true,
      "$when": "${temp != ''}"
    },
    {
      "type": "TextBlock",
      "text": "${note}",
      "spacing": "None",
      "wrap": true,
      "maxLines": 3,
      "isSubtle": true,
      "$when": "${temp == ''}"
    }
  ]
}
